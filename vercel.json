{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "test -f vite.config.ts && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
