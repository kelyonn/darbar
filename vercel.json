{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "test -d client/src && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
