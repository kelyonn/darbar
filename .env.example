# Server
PORT=5001
NODE_ENV=development

# Database
# Local MongoDB works out of the box; use an Atlas mongodb+srv:// URI in production
MONGODB_URI=mongodb://127.0.0.1:27017/darbar

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Nodemailer). Leave SMTP_USER blank in development: emails are logged to the
# server console and new accounts are auto-verified.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Darbar <no-reply@darbar.in>

# Razorpay. Leave blank in development: checkout uses a simulated payment (test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary. Leave blank in development: image uploads return a placeholder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client
CLIENT_URL=http://localhost:5173

# Client (Vite prefix required for browser access)
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=
VITE_SOCKET_URL=http://localhost:5000
